@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(glm REQUIRED CONFIG)
find_dependency(OpenSSL REQUIRED COMPONENTS Crypto)

if(@LGE_CONFIG_HAS_GRAPHICS@)
	find_dependency(LightVulkanGraphics 3.2 CONFIG REQUIRED)
	find_dependency(glfw3 CONFIG REQUIRED)
endif()
if(@LGE_BUILD_DESKTOP_BRIDGE@)
	find_dependency(CURL REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/LightGameEngineTargets.cmake")
check_required_components(LightGameEngine)
